# Copy this file to .env and replace the account placeholders before starting.
# Payment credentials may remain placeholders while PAYMENT_FAKE_MODE is true.
# Generate a different random value for each account secret. Each must contain
# at least 32 UTF-8 bytes. One way to generate a value with Node.js is:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"

PORT=3000
NODE_ENV=development
DB_URL=mongodb://127.0.0.1:27017/account-api?replicaSet=rs0
TEST_DB_URL=mongodb://127.0.0.1:27017/account_api_test?replicaSet=rs0
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=replace-me
JWT_SECRET=replace-me
OTP_SECRET=replace-me
LOGIN_THROTTLE_SECRET=replace-me
REQUEST_THROTTLE_SECRET=replace-me
PAYMENT_PROVIDER=stripe
PAYMENT_FAKE_MODE=true
STRIPE_SECRET_KEY=replace-me
STRIPE_PUBLISHABLE_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me
ZARINPAL_MERCHANT_ID=replace-me
ZARINPAL_CALLBACK_URL=http://localhost:3000/payments/zarinpal/callback
